     /// Unfold the panel down to layer `name` of `doc` and open it, while the panel is shown.
+    /// Color the selected objects, their faces and lines, as the layer panel's color menu does; None restores
+    /// their own. Returns how many were colored.
+    pub(crate) fn color_selected(&mut self, color: Option<[u8; 3]>) -> usize {
+        let mut count = 0;
+
+        for row in self.selected_rows() {
+            let Some(id) = self.scene.identity_of(row) else {
+                continue;
+            };
+
+            if let Some(color) = color {
+                self.scene.colors.insert(id, color);
+            } else {
+                self.scene.colors.remove(&id);
+            }
+
+            self.gpu.set_object_color(row, false, color);
+            count += 1;
+        }
+
+        self.refresh_layers();
+        self.touch();
+        count
+    }
