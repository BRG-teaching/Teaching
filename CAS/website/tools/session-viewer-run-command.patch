new file mode 100644
index 0000000..66acda9
--- /dev/null
+++ b/session_viewer/src/app/command/verbs/color.rs
@@ -0,0 +1,57 @@
+use crate::State;
+use crate::app::command::{Action, Spec};
+
+pub const SPEC: Spec = Spec {
+    options: &["Color Original"],
+    ..Spec::new(
+        &["Color", "Colour"],
+        "Color #rrggbb, r,g,b or Original: the color of the selected objects · Example: Color #3f9c20",
+        parse,
+    )
+};
+
+const USAGE: &str = "Color takes #rrggbb, r,g,b or Original, e.g. Color #3f9c20";
+
+/// The color from "#3f9c20", "3f9c20", "63,156,32" or "Original".
+fn parse(_verb: &str, rest: &[&str]) -> Result<Box<dyn Action>, String> {
+    let text = rest.join("").to_ascii_lowercase();
+
+    if text == "original" {
+        return Ok(Box::new(Color(None)));
+    }
+
+    let hex = text.trim_start_matches('#');
+    let rgb = if hex.len() == 6 && hex.chars().all(|c| c.is_ascii_hexdigit()) {
+        let value = u32::from_str_radix(hex, 16).map_err(|_| USAGE.to_string())?;
+        [(value >> 16) as u8, (value >> 8) as u8, value as u8]
+    } else {
+        let parts = text
+            .split(',')
+            .map(|part| part.trim().parse::<u8>())
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(|_| USAGE.to_string())?;
+        let [r, g, b] = parts[..] else {
+            return Err(USAGE.into());
+        };
+        [r, g, b]
+    };
+    Ok(Box::new(Color(Some(rgb))))
+}
+
+#[derive(Debug)]
+struct Color(Option<[u8; 3]>);
+
+impl Action for Color {
+    /// Color what is selected; pick first, as for Move.
+    fn needs_selection(&self) -> bool {
+        true
+    }
+
+    fn run(&self, state: &mut State) -> Result<String, String> {
+        let count = state.color_selected(self.0);
+        Ok(match self.0 {
+            Some([r, g, b]) => format!("{count} colored #{r:02x}{g:02x}{b:02x}"),
+            None => format!("{count} back to their own color"),
+        })
+    }
+}
