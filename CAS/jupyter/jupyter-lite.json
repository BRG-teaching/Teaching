{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "CAS · COMPAS notebooks",
    "exposeAppInBrowser": true,
    "settingsStorageName": "cas-jupyter-settings",
    "contentsStorageName": "cas-jupyter-contents-11",
    "disabledExtensions": ["@jupyterlab/apputils-extension:announcements"],
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "pyodideUrl": "https://cdn.jsdelivr.net/pyodide/v0.29.3/full/pyodide.mjs"
      }
    },
    "settingsOverrides": {
      "@jupyterlab/apputils-extension:themes": {
        "theme": "JupyterLab Dark",
        "theme-scrollbars": true
      },
      "@jupyterlab/notebook-extension:tracker": {
        "autoStartDefaultKernel": true,
        "codeCellConfig": { "lineNumbers": true }
      }
    }
  }
}
